{% assign settings = shop.metafields['$app:avd']['terms_settings'].value %}

{% if request.design_mode %}
  {% if settings == blank %}
    <div style="padding: 10px; border: 1px dashed #ccc; background: #f9f9f9; text-align: center;">
      <strong>Age Verification App:</strong> Terms & Conditions settings not found. Please save settings in the App Admin.
    </div>
  {% endif %}
{% endif %}

{% assign global_settings = shop.metafields['$app:avd']['settings'].value %}

{% comment %}
  Feature access is computed server-side (PlanService.buildAccessMap) from
  app/constants/features.js and synced here as booleans, so this file never
  duplicates plan-tier comparison logic.
{% endcomment %}
{% assign entitlements = shop.metafields['$app:avd']['entitlements'].value %}
{% assign has_access = entitlements['terms.condition.status'] %}

{% if settings.enabled and has_access %}
  {% assign show_by_page = false %}
  {% assign current_page = request.page_type | default: template.name %}
  
  {% if current_page == 'product' and settings.displayPages contains 'product' %}
    {% assign show_by_page = true %}
  {% elsif current_page == 'cart' and settings.displayPages contains 'cart' %}
    {% assign show_by_page = true %}
  {% endif %}

  {% assign show_by_trigger = false %}
  {% if settings.triggerCondition == 'always' or settings.triggerCondition == blank %}
    {% assign show_by_trigger = true %}
  {% elsif settings.triggerCondition == 'logged' and customer %}
    {% assign show_by_trigger = true %}
  {% elsif settings.triggerCondition == 'not_logged' and customer == nil %}
    {% assign show_by_trigger = true %}
  {% endif %}

  {% if request.design_mode %}
    {% if show_by_page == false or show_by_trigger == false %}
      <div style="padding: 10px; border: 1px dashed #ccc; background: #f9f9f9; text-align: center; margin: 10px 0;">
        <strong>Age Verification App:</strong> Terms & Conditions block is hidden on this page/for this customer based on your settings.
      </div>
      {% assign show_by_page = true %}
      {% assign show_by_trigger = true %}
    {% endif %}
  {% endif %}

  {% if show_by_page and show_by_trigger %}
    {% assign show_brandmark = true %}
    {% if global_settings.showBrandMark == false or global_settings.showBrandMark == 'false' %}
      {% assign show_brandmark = false %}
    {% endif %}

    <div id="avd-terms-wrapper" style="margin: 15px 0; color: {{ settings.color | default: '#000000' }}; font-size: {{ settings.size | default: 14 }}px; font-family: inherit;">
      <label class="avd-terms-label" style="display: flex; align-items: center; cursor: pointer; gap: 8px; line-height: 1.4;">
        <input type="checkbox" id="avd-terms-checkbox" style="margin: 0; flex-shrink: 0; width: 14px; height: 14px; accent-color: #000;">
        <span>
          {% if settings.keyword != blank and settings.link != blank %}
            {% capture link_tag %}<a href="{{ settings.link }}" target="_blank" style="text-decoration: underline; color: inherit;">{{ settings.keyword }}</a>{% endcapture %}
            {{ settings.checkboxText | replace: settings.keyword, link_tag }}
          {% else %}
            {{ settings.checkboxText }}
          {% endif %}
        </span>
      </label>

      {% if show_brandmark %}
      <div style="display: flex; align-items: center; gap: 6px; margin-top: 6px;">
        <span style="font-size: 11px; color: #6D7175;">Protected by</span>
        <div style="display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 600;">
          <div style="width: 16px; height: 16px; border-radius: 4px; background: linear-gradient(135deg,#7C3AED,#EC4899); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="white">
              <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z" />
            </svg>
          </div>
          <a href="https://google.com" target="_blank" style="color: #2C6ECB; text-decoration: underline; font-size: 11px; font-weight: 600;">AVD</a>
        </div>
      </div>
      {% endif %}

      <div id="avd-terms-error" style="color: #d93025; font-size: 13px; margin-top: 8px; display: none; font-weight: 500;">
        {{ settings.errorMessage | default: 'Please agree to the terms and conditions before proceeding.' }}
      </div>
    </div>

    <script src="{{ 'terms-conditions.js' | asset_url }}" defer></script>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Terms & Conditions",
  "target": "section",
  "stylesheet": "age-verification.css",
  "available_if": "{{ app.metafields.avd.terms_available }}",
  "settings": []
}
{% endschema %}

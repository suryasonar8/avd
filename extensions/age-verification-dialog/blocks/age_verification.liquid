<div id="age-verification-overlay" class="age-verification-overlay" style="display: none;">
  <div class="age-verification-modal">
    <div class="age-verification-content">
      <h1>Welcome!</h1>
      <p>Please verify that you are 18 years of age or older to enter this site.</p>
      <div class="age-verification-buttons">
        <button id="age-verify-agree" class="age-verify-button agree">Agree</button>
        <button id="age-verify-disagree" class="age-verify-button disagree">Disagree</button>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Age Verification",
  "target": "body",
  "stylesheet": "age-verification.css",
  "javascript": "age-verification.js",
  "settings": []
}
{% endschema %}

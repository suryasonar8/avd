{% assign settings = shop.metafields.avd.settings.value %}
{% assign min_age = settings.minAge | default: 18 %}
{% assign redirect_url = settings.redirectUrl | default: "https://www.google.com" %}

{% assign active_popup_node = shop.metafields.avd.active_popup.value %}
{% assign active_popup = null %}

{% if active_popup_node %}
  {% assign active_popup = active_popup_node.config.value %}
{% endif %}

{% assign show_popup = false %}
{% if active_popup %}
  {% if active_popup.pages == 'All pages' or active_popup.pages == blank %}
    {% assign show_popup = true %}
  {% elsif active_popup.pages == 'Home page' %}
    {% if request.page_type == 'index' %}
      {% assign show_popup = true %}
    {% endif %}
  {% elsif active_popup.pages == 'Specific collections' or active_popup['pages'] == 'Specific collections' %}
    <!-- Debug: pages is {{ active_popup.pages }}, collection handle is {{ collection.handle }} -->
    {% if request.page_type == 'collection' or collection %}
      {% assign handles = active_popup.selectedCollectionHandles | default: active_popup['selectedCollectionHandles'] %}
      {% for handle in handles %}
        {% assign h = handle | strip %}
        {% if h == collection.handle %}
          {% assign show_popup = true %}
          {% break %}
        {% endif %}
      {% endfor %}
    {% endif %}
  {% elsif active_popup.pages == 'Specific product tags' or active_popup['pages'] == 'Specific product tags' %}
    {% if request.page_type == 'product' or product %}
      {% assign tags = active_popup.selectedProductTags | default: active_popup['selectedProductTags'] %}
      {% for tag in product.tags %}
        {% for selected_tag in tags %}
          {% if tag == selected_tag %}
            {% assign show_popup = true %}
            {% break %}
          {% endif %}
        {% endfor %}
        {% if show_popup %}{% break %}{% endif %}
      {% endfor %}
    {% endif %}
  {% elsif active_popup.pages == 'Specific products' or active_popup['pages'] == 'Specific products' %}
    {% if request.page_type == 'product' or product %}
      {% assign handles = active_popup.selectedProductHandles | default: active_popup['selectedProductHandles'] %}
      {% for handle in handles %}
        {% assign h = handle | strip %}
        {% if h == product.handle %}
          {% assign show_popup = true %}
          {% break %}
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endif %}
  
  {% if show_popup and active_popup.trigger == 'Logged customers' %}
    {% if customer == nil %}
      {% assign show_popup = false %}
    {% endif %}
  {% endif %}
{% endif %}

{% if show_popup %}
  <!-- Debug: active_popup ID is {{ active_popup.id }} -->
  {% assign background_page = active_popup.background.pageColor | default: 'rgba(0,0,0,0.7)' %}
  {% assign background_bg = active_popup.background.bgColor | default: '#FFFFFF' %}
  {% assign background_border_color = active_popup.background.borderColor | default: '#FFFFFF' %}
  {% assign background_border_width = active_popup.background.borderWidth | default: 0 %}
  {% assign background_border_radius = active_popup.background.borderRadius | default: 0 %}
  {% assign background_image = active_popup.background.backgroundImage %}
  {% assign logo_url = active_popup.background.logo %}
  {% assign background_type = active_popup.background.type | default: 'Solid color background' %}
  
  {% assign text_heading = active_popup.text.heading | default: 'Welcome!' %}
  {% assign text_subheading = active_popup.text.subheading | default: 'Please verify your age to enter this site.' %}
  
  {% assign btn_submit = active_popup.button.submitText | default: 'Agree' %}
  {% assign btn_cancel = active_popup.button.cancelText | default: 'Disagree' %}
  {% assign btn_bg = active_popup.button.bgColor | default: '#FE4D01' %}
  {% assign btn_border_color = active_popup.button.borderColor | default: '#FFFFFF' %}
  {% assign btn_border_width = active_popup.button.borderWidth | default: 0 %}
  {% assign btn_border_radius = active_popup.button.borderRadius | default: 0 %}
  
  {% assign cancel_action = active_popup.button.cancelAction | default: 'redirect' %}
  {% assign cancel_redirect_url = active_popup.button.redirectUrl | default: redirect_url %}
  {% assign cancel_error_msg = active_popup.button.cancelErrorMsg | default: '' %}
  {% assign submit_error_msg = active_popup.button.errorMsg | default: '' %}
  
  {% assign cancel_btn_bg = active_popup.button.cancelBgColor | default: '#A0A0A0' %}
  {% assign cancel_btn_border_color = active_popup.button.cancelBorderColor | default: '#FFFFFF' %}
  {% assign cancel_btn_border_width = active_popup.button.cancelBorderWidth | default: 0 %}
  {% assign cancel_btn_border_radius = active_popup.button.cancelBorderRadius | default: 0 %}

  {% assign method = active_popup.method | default: 'No input' %}
  {% assign date_order = active_popup.dateOrder | default: 'MM,DD,YY' %}

  {% assign remember_visitor = settings.rememberVisitor | default: 'Session only' %}
  {% assign remember_days = settings.rememberDays | default: 30 %}

  {% assign current_locale = request.locale.iso_code %}
  {% assign translations = active_popup.translations[current_locale] %}

  {% if translations %}
    {% if translations.heading != blank %}
      {% assign text_heading = translations.heading %}
    {% endif %}
    {% if translations.subheading != blank %}
      {% assign text_subheading = translations.subheading %}
    {% endif %}
    {% if translations.submitLabel != blank %}
      {% assign btn_submit = translations.submitLabel %}
    {% endif %}
    {% if translations.cancelLabel != blank %}
      {% assign btn_cancel = translations.cancelLabel %}
    {% endif %}
    {% if translations.submitErrorMsg != blank %}
      {% assign submit_error_msg = translations.submitErrorMsg %}
    {% endif %}
    {% if translations.cancelErrorMsg != blank %}
      {% assign cancel_error_msg = translations.cancelErrorMsg %}
    {% endif %}
  {% endif %}

<div id="age-verification-overlay" class="age-verification-overlay" style="display: none; background-color: {{ background_page }}; {% if background_type == 'Image background' and background_image != blank %}background-image: url('{{ background_image }}'); background-size: cover; background-position: center;{% endif %}" 
     data-min-age="{{ min_age }}" 
     data-redirect-url="{{ redirect_url }}"
     data-cancel-action="{{ cancel_action }}"
     data-cancel-redirect-url="{{ cancel_redirect_url }}"
     data-cancel-error-msg="{{ cancel_error_msg | escape }}"
     data-submit-error-msg="{{ submit_error_msg | escape }}"
     data-remember-visitor="{{ remember_visitor }}"
     data-remember-days="{{ remember_days }}"
     data-method="{{ method }}">
  <div class="age-verification-modal" style="background-color: {{ background_bg }}; border: {{ background_border_width }}px solid {{ background_border_color }}; border-radius: {{ background_border_radius }}px;">
    <div class="age-verification-content">
      {% if logo_url != blank %}
        <div class="age-verification-logo" style="text-align: center; margin-bottom: 20px;">
          <img src="{{ logo_url }}" alt="Logo" style="max-width: 150px; max-height: 80px; object-fit: contain;">
        </div>
      {% endif %}
      <h3 class="age-verification-heading">{{ text_heading }}</h3>
      <p class="age-verification-subheading">{{ text_subheading }}</p>

      {% assign method_down = method | downcase %}
      {% if method_down contains 'birthdate' %}
        <div class="age-verification-birthdate">
          {% assign parts = date_order | split: ',' %}
          {% for part in parts %}
            {% assign trimmed_part = part | strip %}
            {% if trimmed_part == 'MM' %}
              <select id="age-verify-month" class="age-verify-select">
                <option value="1" selected>{{ translations.months['January'] | default: 'January' }}</option>
                <option value="2">{{ translations.months['February'] | default: 'February' }}</option>
                <option value="3">{{ translations.months['March'] | default: 'March' }}</option>
                <option value="4">{{ translations.months['April'] | default: 'April' }}</option>
                <option value="5">{{ translations.months['May'] | default: 'May' }}</option>
                <option value="6">{{ translations.months['June'] | default: 'June' }}</option>
                <option value="7">{{ translations.months['July'] | default: 'July' }}</option>
                <option value="8">{{ translations.months['August'] | default: 'August' }}</option>
                <option value="9">{{ translations.months['September'] | default: 'September' }}</option>
                <option value="10">{{ translations.months['October'] | default: 'October' }}</option>
                <option value="11">{{ translations.months['November'] | default: 'November' }}</option>
                <option value="12">{{ translations.months['December'] | default: 'December' }}</option>
              </select>
            {% elsif trimmed_part == 'DD' %}
              <select id="age-verify-day" class="age-verify-select">
                {% for i in (1..31) %}
                  <option value="{{ i }}" {% if i == 1 %}selected{% endif %}>{{ i }}</option>
                {% endfor %}
              </select>
            {% elsif trimmed_part == 'YY' %}
              <select id="age-verify-year" class="age-verify-select">
                {% assign current_year = "now" | date: "%Y" | plus: 0 %}
                {% assign start_year = current_year | minus: 100 %}
                {% for i in (start_year..current_year) reversed %}
                  <option value="{{ i }}" {% if i == 2026 %}selected{% endif %}>{{ i }}</option>
                {% endfor %}
              </select>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      <div class="age-verification-buttons">
        <button id="age-verify-agree" class="age-verify-button agree" style="background-color: {{ btn_bg }}; color: #FFF; border: {{ btn_border_width }}px solid {{ btn_border_color }}; border-radius: {{ btn_border_radius }}px;">{{ btn_submit }}</button>
         <button id="age-verify-disagree" class="age-verify-button disagree" style="background-color: {{ cancel_btn_bg }}; color: #FFF; border: {{ cancel_btn_border_width }}px solid {{ cancel_btn_border_color }}; border-radius: {{ cancel_btn_border_radius }}px;">{{ btn_cancel }}</button>
      </div>

      {% if remember_visitor == 'Allow visitor to choose' %}
        <div class="age-verification-remember">
          <label>
            <input type="checkbox" id="age-verify-remember-me"> Remember my information for next time.
          </label>
        </div>
      {% endif %}

      <p id="age-verify-error-text" style="display: none; color: red; margin-top: 15px;"></p>

      {% if active_popup.showBrandMark != false %}
        <div class="age-verification-footer">
          Protected by <span class="brand-mark"><span class="brand-shield">🛡️</span> <span class="brand-name">Blockify™</span></span>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "Age Verification",
  "target": "body",
  "stylesheet": "age-verification.css",
  "javascript": "age-verification.js",
  "settings": []
}
{% endschema %}

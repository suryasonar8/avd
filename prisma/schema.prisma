// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model AppSettings {
  id          Int      @id @default(autoincrement())
  shop        String   @unique
  minAge      Int      @default(18)
  redirectUrl String   @default("https://www.google.com")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ShopPlan {
  shop      String   @id
  plan      String   @default("free")
  updatedAt DateTime @updatedAt
}

model Popup {
  id        Int      @id @default(autoincrement())
  shop      String
  name      String   @default("Untitled Popup")
  config    String   // Full JSON config blob
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations Translation[]

  @@index([shop])
}

model Translation {
  id             Int    @id @default(autoincrement())
  popupId        Int
  locale         String
  heading        String?
  subheading     String?
  submitLabel    String?
  cancelLabel    String?
  submitErrorMsg String?
  cancelErrorMsg String?
  submitAction   String?
  cancelAction   String?
  months         String? // JSON string for month names

  popup Popup @relation(fields: [popupId], references: [id], onDelete: Cascade)

  @@unique([popupId, locale])
}

model CheckoutBanner {
  id        Int      @id @default(autoincrement())
  shop      String   @unique
  config    String   // Full JSON config blob
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
}

model TermsSettings {
  id        Int      @id @default(autoincrement())
  shop      String   @unique
  config    String   // Full JSON config blob
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
}

model AnalyticsEvent {
  id        Int      @id @default(autoincrement())
  shop      String
  type      String   // "verified" | "unverified"
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}
